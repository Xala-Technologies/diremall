# Local development: `npx convex dev` writes these into .env.local.
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Demo only: extra ETB added to the Overview "Collected" card. Leave unset in real use.
# NEXT_PUBLIC_DEMO_EXTRA_COLLECTED_ETB=10000000

# Vercel: set only CONVEX_DEPLOY_KEY (production deploy key), scoped to the Production environment.
# `npx convex deploy` in vercel.json fills in NEXT_PUBLIC_CONVEX_URL during the build.
